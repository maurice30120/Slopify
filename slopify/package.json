{
  "name": "slopify",
  "version": "0.1.0",
  "private": false,
  "description": "Run ACP v3 pipelines and Docker Sandbox agents from a terminal with Slopify.",
  "type": "module",
  "main": "./dist/bin/cli.js",
  "files": [
    "dist/bin",
    "dist/resources"
  ],
  "scripts": {
    "build": "npm --prefix .. run build -w @acp-client/workspace && npm --prefix .. exec -- tsc -p tsconfig.json --incremental false && node scripts/build-resources.mjs && node scripts/build-cli.mjs",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm --prefix .. run build",
    "test:package": "npm run build && node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "@acp-client/pipeline": "file:../acp-pipeline",
    "@acp-client/workspace": "file:../acp-workspace",
    "js-yaml": "^4.1.1"
  },
  "dependencies": {
    "markstream-cli": "^0.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "slopify": "./dist/bin/cli.js"
  }
}
