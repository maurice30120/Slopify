{
  "name": "@acp-client/pipeline",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "test": "npm run clean:test && npm run build && tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "test:watch": "npm run build && tsc -p tsconfig.test.json && node --test --watch \"dist-test/**/*.test.js\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:test": "node -e \"require('fs').rmSync('dist-test', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.0",
    "@langchain/langgraph": "^1.4.17"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2"
  }
}
